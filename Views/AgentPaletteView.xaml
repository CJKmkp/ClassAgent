<UserControl x:Class="ClassAgent.Views.AgentPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ca="clr-namespace:ClassAgent.Resources"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             MinWidth="210">
    <Border Padding="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>
            <TextBlock Text="{Binding ToolbarName, Source={x:Static ca:Localized.Current}}"
                       FontWeight="SemiBold" Margin="0,0,0,8" />
            <UniformGrid Columns="2">
                <Button x:Name="PenButton" Click="PenButton_Click" Margin="2" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding ToolPen, Source={x:Static ca:Localized.Current}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SelectButton" Click="SelectButton_Click" Margin="2" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.TouchPointer}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding ToolSelect, Source={x:Static ca:Localized.Current}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="EraserButton" Click="EraserButton_Click" Margin="2" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.EraseTool}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding ToolEraser, Source={x:Static ca:Localized.Current}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ShapeButton" Click="ShapeButton_Click" Margin="2" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Draw}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding ToolShape, Source={x:Static ca:Localized.Current}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="RoamingButton" Click="RoamingButton_Click" Margin="2" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FullScreen}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding ToolRoaming, Source={x:Static ca:Localized.Current}}" />
                    </StackPanel>
                </Button>
            </UniformGrid>
            <Button Click="OpenButton_Click" Margin="2,10,2,2" Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Message}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding WindowTitle, Source={x:Static ca:Localized.Current}}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
