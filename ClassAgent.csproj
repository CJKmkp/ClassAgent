<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>ClassAgent</RootNamespace>
    <AssemblyName>ClassAgent</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <HostRepoRoot Condition="'$(HostRepoRoot)' == ''">..\ICC CE main\community</HostRepoRoot>
    <PluginSdkPackageVersion Condition="'$(PluginSdkPackageVersion)' == ''">1.8.0.8-g90c1bad8f3</PluginSdkPackageVersion>
    <PluginControlsPackageVersion Condition="'$(PluginControlsPackageVersion)' == ''">1.8.0.8-g90c1bad8f3</PluginControlsPackageVersion>
    <HasLocalHostSdk Condition="Exists('$(HostRepoRoot)\InkCanvas.PluginSdk\InkCanvas.PluginSdk.csproj')">true</HasLocalHostSdk>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasLocalHostSdk)' == 'true'">
    <ProjectReference Include="$(HostRepoRoot)\InkCanvas.PluginSdk\InkCanvas.PluginSdk.csproj" />
    <ProjectReference Include="$(HostRepoRoot)\InkCanvas.Controls\InkCanvas.Controls.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(HasLocalHostSdk)' != 'true'">
    <PackageReference Include="InkCanvas.PluginSdk" Version="$(PluginSdkPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="InkCanvas.Controls" Version="$(PluginControlsPackageVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(HostRepoRoot)\InkCanvas.PluginSdk\InkCanvas.PluginSdk.targets"
          Condition="Exists('$(HostRepoRoot)\InkCanvas.PluginSdk\InkCanvas.PluginSdk.targets')" />
</Project>
